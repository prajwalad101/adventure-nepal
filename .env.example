# Required — Resend API key for the contact form
RESEND_API_KEY=

# Optional — defaults applied in env.ts if unset
# Switch to a verified adventurenepal.com sender before launch
CONTACT_FROM_EMAIL=Adventure Nepal Website <onboarding@resend.dev>

# Set to 1 to skip validation (e.g. CI/Docker builds without secrets)
# SKIP_ENV_VALIDATION=
